# Web paneli yönetici giriş bilgileri (Railway Variables veya .env içine girin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Bildirimlerin gideceği Telegram sohbet veya grup ID'si (örn. 123456789 veya -100...)
CHAT_ID=

# @BotFather'dan alınan token (isteğe bağlı, bildirim göndermek için)
TELEGRAM_BOT_TOKEN=
# Ofis sahibinin Telegram ID'si (birden fazla ise virgülle). @userinfobot ile öğrenilir.
OWNER_TELEGRAM_IDS=
DB_PATH=emlak.db
TIMEZONE=Europe/Istanbul
REMINDER_HOUR=9
INACTIVITY_DAYS=7
# Web oturum anahtarı: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Botun gösterdiği panel adresi (Railway domain'i)
WEB_URL=http://localhost:8000
# Railway'de PORT otomatik gelir. Web'i kapatmak için WEB_ENABLED=0
GROUP_CHAT_ID=
SETUP_CODE=
