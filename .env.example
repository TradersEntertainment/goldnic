# ======================================================================
# Gold Nicomedia OS — ortam değişkenleri (Railway → Variables veya .env)
# ======================================================================

# --- Temel ---
# Web oturum anahtarı (ZORUNLU, sabit kalmalı): python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
DB_PATH=emlak.db                 # Railway'de: /data/emlak.db (volume /data'ya bağlı olmalı)
TIMEZONE=Europe/Istanbul
WEB_URL=http://localhost:8000    # Bildirimlerdeki bağlantılar için panel adresi (Railway domain'i)
# Railway'de PORT otomatik gelir. Web'i kapatmak için WEB_ENABLED=0
BRAND_NAME=Gold Nicomedia

# --- Web paneli yöneticisi (ofis sahibi) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=              # @BotFather
OWNER_TELEGRAM_IDS=              # Ofis sahibinin sayısal Telegram ID'si (@userinfobot). Gece yedeği buraya gider.
CHAT_ID=                         # Bildirimlerin gideceği sohbet/grup (-100...)
GROUP_CHAT_ID=
SETUP_CODE=
REMINDER_HOUR=9                  # Kira hatırlatmaları (09:00); müşteri eşleştirme özeti 09:20
INACTIVITY_DAYS=7

# --- Türk kira hukuku / TÜFE ---
EVDS_API_KEY=                    # TCMB EVDS anahtarı (isteğe bağlı; yoksa TÜİK bülteni ve yerleşik tablo)
EVDS_TUFE_SERIES=TP.FG.J0
TUFE_REFRESH_HOUR=11             # TÜİK her ayın 3'ünde 10:00'da açıklar; 11:05'te çekilir

# --- Resmi belgeler (PDF başlığı) ---
BRAND_ADDRESS=İzmit / Kocaeli
BRAND_PHONE=
BRAND_LICENSE_NO=                # Taşınmaz ticareti yetki belgesi no

# --- Performans panosu (tahmini hizmet bedeli, KDV hariç) ---
COMMISSION_RENT_MONTHS=1         # Kiralamada aylık kira katı
COMMISSION_SALE_PCT=4            # Satışta toplam yüzde (alıcı + satıcı)

# --- Şifreli gece yedeği ---
BACKUP_PASSPHRASE=               # Yedek şifresi (uzun bir cümle). Kaybetmeyin: yedek bu olmadan açılamaz.
BACKUP_HOUR=3                    # Her gece 03:00 (İstanbul)
BACKUP_KEEP=14                   # Sunucuda saklanacak son yedek sayısı
BACKUP_DIR=                      # Boşsa veritabanının yanındaki backups/ klasörü (/data/backups)
BACKUP_CHAT_ID=                  # Boşsa OWNER_TELEGRAM_IDS (yalnızca kişisel sohbet; grup değil)
BACKUP_S3_URL=                   # İsteğe bağlı: https://<hesap>.r2.cloudflarestorage.com/<bucket>
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=gold-nicomedia

# --- WhatsApp (isteğe bağlı otomatik gönderim; tek tık wa.me bağlantıları her zaman çalışır) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_URL=
WHATSAPP_TARGET_PHONE=           # Ofis WhatsApp numarası (kritik uyarılar)
